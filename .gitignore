# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
**/out/

# production
/build
**/dist/

# misc
.DS_Store
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# python cache & virtual environments
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# env files (can opt-in for committing if needed)
.env*
!.env*.example
!backend/.env*.example
!frontend/.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
**/next-env.d.ts

# sensitive data, sheets, exports, database backups
*.xlsx
*.xls
*.csv
*.tsv
*.ods
*.db
*.sqlite
*.sqlite3
*.dump
*.bak
*.backup
*.jsonl
/data/
/exports/
/reports/
/backups/
/temp/
/tmp/
